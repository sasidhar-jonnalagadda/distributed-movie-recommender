# ==============================================================================
# Movie Recommendation Platform - Environmental Configuration Template
# ==============================================================================
# Usage: Copy this file to '.env' and fill in the actual secrets.
# DO NOT COMMIT THE '.env' FILE TO VERSION CONTROL.

# --- Database (PostgreSQL) ---
DB_USER=movieuser
DB_PASSWORD=your_secure_password_here
DB_NAME=moviedb
DB_HOST=postgres
DB_PORT=5432
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# --- Service Ports ---
GATEWAY_PORT=4000
ML_PORT=8000
FRONTEND_PORT=3000

# --- Authentication (JWT) ---
# Generate a secure secret using: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# --- Machine Learning Service ---
# The internal Docker network address is used here by default
ML_SERVICE_URL=http://ml-service:8000
MODEL_PATH=/app/artifacts

# --- External APIs (The Movie Database) ---
# Get your API key from: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE=https://image.tmdb.org/t/p

# --- Frontend (Next.js) ---
# Public URL for the API Gateway (accessed by the browser)
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- General ---
# Set to 'production' to enable strict secret validation
NODE_ENV=development
